{
  "scopeName": "source.np",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#nepali-keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#function-calls"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.hash.np",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.np",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.np",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.np",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.np",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.np",
          "match": "\\b(if|else|elif|for|while|def|return|class|import|from|try|except|finally|raise|with|in|is|and|or|not)\\b"
        },
        {
          "name": "constant.language.np",
          "match": "\\b(True|False|None)\\b"
        }
      ]
    },
    "nepali-keywords": {
      "patterns": [
        {
          "name": "keyword.control.nepali.np",
          "match": "\\b(yedi|natra|natabhaye|jabasamma|ko_lagi|kaam|firta|kakshya|lyau|bata|koshish|samau|antya|uthau|bhitra|ma|ra|wa|hoina)\\b"
        },
        {
          "name": "constant.language.nepali.np",
          "match": "\\b(sacho|jhut|khali)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.np",
          "match": "\\b(print|input|len|type|str|int|float|bool|list|map|set|sum|min|max|abs|round|sorted|enumerate|zip|range|yo)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.np",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.numeric.float.np",
          "match": "\\b\\d+\\.\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.np",
          "match": "(=|\\+=|-=|\\*=|/=)"
        },
        {
          "name": "keyword.operator.arithmetic.np",
          "match": "(\\+|-|\\*|/|%|\\*\\*)"
        },
        {
          "name": "keyword.operator.comparison.np",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.np",
          "match": "(and|or|not|ra|wa|hoina)"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "meta.function-call.np",
          "match": "\\b([a-zA-Z_\\u0900-\\u097F][a-zA-Z0-9_\\u0900-\\u097F]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.np"
            }
          }
        }
      ]
    }
  }
}