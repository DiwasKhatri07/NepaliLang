# Async/Await - Asynchronous Programming
# Using asyn library for async operations

lyau asyn

# Basic async function
asyn kaam simple_async():
    print("Starting async operation")
    # await asyn.sleep(1)  # Simulate async work
    print("Async operation complete")
    firta "Result"

# Running async functions
kaam run_basic_async():
    print("\n=== Basic Async ===")
    # asyn.run(simple_async())
    print("Async pattern demonstration")

run_basic_async()

# Multiple async tasks
asyn kaam fetch_data(url):
    print("Fetching:", url)
    # await asyn.sleep(1)  # Simulate network request
    firta "Data from " + url

asyn kaam main_async():
    print("\n=== Multiple Async Tasks ===")
    
    # Run multiple tasks concurrently
    # results = await asyn.gather([
    #     fetch_data("https://api1.com"),
    #     fetch_data("https://api2.com"),
    #     fetch_data("https://api3.com")
    # ])
    
    # ko_lagi result ma results:
    #     print(result)
    
    print("Concurrent async pattern")

# asyn.run(main_async())

# Async with error handling
asyn kaam async_with_error():
    print("\n=== Async Error Handling ===")
    
    koshish:
        # await risky_async_operation()
        print("Async operation completed")
    samau error:
        print("Async error:", error)

# asyn.run(async_with_error())

# Practical example: Async HTTP client
asyn kaam async_http_client():
    print("\n=== Async HTTP Client ===")
    
    urls = [
        "https://api1.com/data",
        "https://api2.com/data",
        "https://api3.com/data"
    ]
    
    # Fetch all URLs concurrently
    # responses = await asyn.gather([
    #     anurodh.get_async(url) ko_lagi url ma urls
    # ])
    
    # ko_lagi response ma responses:
    #     print("Status:", response.status)
    
    print("Async HTTP pattern:")
    print("  - Concurrent requests")
    print("  - Non-blocking I/O")
    print("  - Efficient resource usage")

# asyn.run(async_http_client())

