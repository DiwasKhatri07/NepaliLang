# Operator Overloading - Custom operators
# Special methods for operators

kakshya Vector:
    kaam __init__(self, x, y):
        self.x = x
        self.y = y
    
    kaam __add__(self, other):
        firta Vector(self.x + other.x, self.y + other.y)
    
    kaam __sub__(self, other):
        firta Vector(self.x - other.x, self.y - other.y)
    
    kaam __mul__(self, scalar):
        firta Vector(self.x * scalar, self.y * scalar)
    
    kaam __str__(self):
        firta "Vector(" + str(self.x) + ", " + str(self.y) + ")"
    
    kaam magnitude(self):
        firta (self.x * self.x + self.y * self.y) ** 0.5

# Create vectors
v1 = Vector(3, 4)
v2 = Vector(1, 2)

print("v1:", v1)
print("v2:", v2)

# Addition
v3 = v1 + v2
print("v1 + v2:", v3)

# Subtraction
v4 = v1 - v2
print("v1 - v2:", v4)

# Scalar multiplication
v5 = v1 * 2
print("v1 * 2:", v5)

# Magnitude
print("Magnitude of v1:", v1.magnitude())

# Complex number example
kakshya Complex:
    kaam __init__(self, real, imag):
        self.real = real
        self.imag = imag
    
    kaam __add__(self, other):
        firta Complex(self.real + other.real, self.imag + other.imag)
    
    kaam __str__(self):
        firta str(self.real) + " + " + str(self.imag) + "i"

c1 = Complex(3, 4)
c2 = Complex(1, 2)
print("Complex sum:", c1 + c2)
