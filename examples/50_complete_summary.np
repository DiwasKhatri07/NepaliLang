print("\nVision:")
print("  'A modern, simple programming language")
print("   from Nepal that makes programming and")
print("   automation easy to understand.'")

print("\nDesign Principles:")
print("  - Python-like syntax")
print("  - Nepali identity")
print("  - Simple and expressive")
