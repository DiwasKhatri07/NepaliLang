# Recursion - Functions calling themselves
# Recursive patterns and algorithms

# Factorial using recursion
kaam factorial(n):
    yedi n <= 1:
        firta 1
    natra:
        firta n * factorial(n - 1)

print("5! =", factorial(5))
print("10! =", factorial(10))

# Fibonacci sequence
kaam fibonacci(n):
    yedi n <= 1:
        firta n
    natra:
        firta fibonacci(n - 1) + fibonacci(n - 2)

print("Fibonacci(10) =", fibonacci(10))

# Recursive sum of list
kaam recursive_sum(numbers, index=0):
    yedi index >= len(numbers):
        firta 0
    natra:
        firta numbers[index] + recursive_sum(numbers, index + 1)

nums = [1, 2, 3, 4, 5]
print("Sum:", recursive_sum(nums))

# Recursive reverse string
kaam reverse_string(s):
    yedi len(s) <= 1:
        firta s
    natra:
        firta reverse_string(s[1:]) + s[0]

print("Reverse 'hello':", reverse_string("hello"))

# Binary search (recursive)
kaam binary_search(arr, target, low=0, high=khali):
    yedi high == khali:
        high = len(arr) - 1
    
    yedi low > high:
        firta -1
    
    mid = (low + high) // 2
    
    yedi arr[mid] == target:
        firta mid
    natra:
        yedi arr[mid] > target:
            firta binary_search(arr, target, low, mid - 1)
        natra:
            firta binary_search(arr, target, mid + 1, high)

sorted_arr = [1, 3, 5, 7, 9, 11, 13]
print("Binary search for 7:", binary_search(sorted_arr, 7))
