# Project Structure and Organization
# Organizing NepaliCode projects effectively

# Standard project structure
project_structure = """
my_project/
├── main.np              # Entry point
├── config.np            # Configuration
├── src/                 # Source code
│   ├── utils.np
│   ├── models.np
│   └── services.np
├── tests/               # Tests
│   ├── test_utils.np
│   └── test_models.np
├── docs/                # Documentation
│   └── README.md
└── stdlib/              # Custom standard library
    └── my_module.np
"""

print("=== Project Structure ===")
print(project_structure)

# Configuration management
kakshya ProjectConfig:
    kaam __init__(self):
        self.name = "My Project"
        self.version = "1.0.0"
        self.author = "Diwas"
        self.description = "A NepaliCode project"
        self.dependencies = []
        self.settings = {
            "debug": jhut,
            "log_level": "INFO",
            "output_dir": "output"
        }
    
    kaam add_dependency(self, dependency):
        self.dependencies.append(dependency)
    
    kaam get_setting(self, key):
        firta self.settings.get(key, khali)
    
    kaam set_setting(self, key, value):
        self.settings[key] = value

print("\n=== Configuration Management ===")
config = ProjectConfig()
config.add_dependency("ganit")
config.add_dependency("jsonlib")
print("Project:", config.name, config.version)
print("Dependencies:", config.dependencies)

# Module organization
kakshya ModuleRegistry:
    kaam __init__(self):
        self.modules = {}
        self.import_order = []
    
    kaam register(self, name, module):
        yedi name hoina ma self.modules:
            self.modules[name] = module
            self.import_order.append(name)
            print("Registered module:", name)
    
    kaam get(self, name):
        firta self.modules.get(name, khali)
    
    kaam list_modules(self):
        firta self.import_order

print("\n=== Module Organization ===")
registry = ModuleRegistry()
registry.register("utils", {"helper": "function"})
registry.register("models", {"User": "class"})
registry.register("services", {"api": "service"})
print("Available modules:", registry.list_modules())

# Package structure
kakshya Package:
    kaam __init__(self, name):
        self.name = name
        self.modules = {}
        self.version = "1.0.0"
    
    kaam add_module(self, module_name, module_code):
        self.modules[module_name] = module_code
    
    kaam get_module(self, module_name):
        firta self.modules.get(module_name, khali)

print("\n=== Package Structure ===")
my_package = Package("mypackage")
my_package.add_module("core", "Core functionality")
my_package.add_module("utils", "Utility functions")
print("Package:", my_package.name, "v" + my_package.version)
print("Modules:", list(my_package.modules.keys()))

# File organization patterns
kaam organize_files(file_list):
    print("\n=== File Organization ===")
    
    categories = {
        "source": [],
        "test": [],
        "config": [],
        "docs": [],
        "other": []
    }
    
    ko_lagi file ma file_list:
        yedi file.endswith(".np"):
            yedi "test" ma file:
                categories["test"].append(file)
            athawa file == "main.np" or file == "config.np":
                categories["config"].append(file)
            natra:
                categories["source"].append(file)
        athawa file.endswith(".md"):
            categories["docs"].append(file)
        natra:
            categories["other"].append(file)
    
    ko_lagi category, files ma categories:
        print(category + ":", files)
    
    firta categories

files = [
    "main.np",
    "config.np",
    "utils.np",
    "test_utils.np",
    "README.md",
    "setup.py"
]
organize_files(files)

# Dependency management
kakshya DependencyManager:
    kaam __init__(self):
        self.dependencies = {}
        self.dev_dependencies = {}
    
    kaam add_dependency(self, name, version="latest"):
        self.dependencies[name] = version
    
    kaam add_dev_dependency(self, name, version="latest"):
        self.dev_dependencies[name] = version
    
    kaam install_dependencies(self):
        print("Installing dependencies:")
        ko_lagi name, version ma self.dependencies:
            print("  -", name, "@" + version)
    
    kaam check_conflicts(self):
        print("Checking for conflicts...")
        conflicts = []
        ko_lagi name ma self.dependencies:
            yedi name ma self.dev_dependencies:
                conflicts.append(name)
        firta conflicts

print("\n=== Dependency Management ===")
deps = DependencyManager()
deps.add_dependency("ganit", "1.0.0")
deps.add_dependency("jsonlib", "1.0.0")
deps.add_dev_dependency("test_framework", "0.1.0")
deps.install_dependencies()
print("Conflicts:", deps.check_conflicts())

# Build system (concept)
kakshya BuildSystem:
    kaam __init__(self):
        self.build_steps = []
    
    kaam add_step(self, step_name, step_function):
        self.build_steps.append({"name": step_name, "func": step_function})
    
    kaam build(self):
        print("Starting build process...")
        ko_lagi step ma self.build_steps:
            print("Executing:", step["name"])
            # step["func"]()  # Would execute the function
        print("Build complete")

print("\n=== Build System ===")
build = BuildSystem()
build.add_step("Compile", lambda: print("Compiling..."))
build.add_step("Test", lambda: print("Testing..."))
build.add_step("Package", lambda: print("Packaging..."))
build.build()

# Documentation structure
kakshya Documentation:
    kaam __init__(self):
        self.sections = {}
    
    kaam add_section(self, title, content):
        self.sections[title] = content
    
    kaam generate_docs(self):
        print("=== Documentation ===")
        ko_lagi title, content ma self.sections:
            print("\n" + title)
            print("-" * len(title))
            print(content)

print("\n=== Documentation ===")
docs = Documentation()
docs.add_section("Installation", "Install NepaliCode from the official website")
docs.add_section("Quick Start", "Run 'nepali main.np' to start")
docs.add_section("API Reference", "See stdlib documentation")
docs.generate_docs()

# Project metadata
kakshya ProjectMetadata:
    kaam __init__(self):
        self.metadata = {
            "name": "",
            "version": "",
            "description": "",
            "author": "",
            "license": "",
            "repository": "",
            "keywords": []
        }
    
    kaam set(self, key, value):
        self.metadata[key] = value
    
    kaam get(self, key):
        firta self.metadata.get(key, "")
    
    kaam to_string(self):
        result = ""
        ko_lagi key, value ma self.metadata:
            result += key + ": " + str(value) + "\n"
        firta result

print("\n=== Project Metadata ===")
metadata = ProjectMetadata()
metadata.set("name", "MyApp")
metadata.set("version", "1.0.0")
metadata.set("author", "Diwas")
metadata.set("license", "MIT")
print(metadata.to_string())

# Workspace management
kakshya Workspace:
    kaam __init__(self, path):
        self.path = path
        self.projects = {}
    
    kaam add_project(self, name, project_path):
        self.projects[name] = project_path
    
    kaam list_projects(self):
        print("Workspace:", self.path)
        print("Projects:")
        ko_lagi name, path ma self.projects:
            print("  -", name, ":", path)

print("\n=== Workspace Management ===")
workspace = Workspace("C:/Users/Diwas/nepali_projects")
workspace.add_project("app1", "C:/Users/Diwas/nepali_projects/app1")
workspace.add_project("app2", "C:/Users/Diwas/nepali_projects/app2")
workspace.list_projects()
